# ── Site ──────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase (Project Settings → API / Database) ──────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx      # or the legacy anon key
SUPABASE_SECRET_KEY=sb_secret_xxx                            # server only: storage + admin user ops. NEVER expose.
DATABASE_URL=postgres://postgres.YOUR-PROJECT:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres  # transaction pooler

# Social sign-in buttons to show. Enable each provider in Supabase Auth first.
# Supported values: google, facebook, linkedin_oidc, custom:yahoo
NEXT_PUBLIC_OAUTH_PROVIDERS=

# ── Payments (Razorpay). Leave blank until merchant onboarding is complete. ──
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Email (Resend). Blank = emails are skipped, in-app notifications still work. ──
RESEND_API_KEY=
EMAIL_FROM="QuikHire <no-reply@example.com>"

# ── Scheduled jobs ────────────────────────────────────
CRON_SECRET=generate-a-long-random-string

# ── Storage: supabase (production) | local (development/tests only) ──
STORAGE_DRIVER=supabase
